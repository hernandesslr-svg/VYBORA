NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://vybora:CHANGE_ME@db:5432/vybora
DATABASE_SSL=false
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGIN=https://your-frontend-domain.example
AUTO_MIGRATE=false
# Storage S3-compatible. Use private bucket; never put these credentials in Android.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=vybora-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
