# PostgreSQL do Supabase usado APENAS pelo backend Node.js
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@HOST_POOLER:5432/postgres
DATABASE_SSL=true
AUTO_MIGRATE=false
JWT_SECRET=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS
CORS_ORIGIN=https://seu-dominio-web.example
# Armazenamento separado e portátil S3-compatible (não é obrigatório ser Supabase Storage)
S3_ENDPOINT=https://endpoint-do-provedor.example
S3_REGION=auto
S3_BUCKET=vybora-private
S3_ACCESS_KEY_ID=CHAVE_PRIVADA
S3_SECRET_ACCESS_KEY=SEGREDO_PRIVADO
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
